meta {
  name: Masterlist - Missing Category
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/masterlists
  body: none
  auth: bearer
}

auth:bearer {
  token: {{midwifeToken}}
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("status code is 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("error code is validation_failed", function() {
    expect(res.body.error.code).to.equal("validation_failed");
  });
}

