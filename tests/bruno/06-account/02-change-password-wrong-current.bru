meta {
  name: Change Password - Wrong Current Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{midwifeToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "Wrong#00000",
    "new_password": "Temp#12345"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("status code is 400 (not 401, so the user stays signed in)", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("the error points at current_password", function() {
    expect(res.body.error.details[0].field).to.equal("current_password");
  });
}
