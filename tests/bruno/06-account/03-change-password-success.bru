meta {
  name: Change Password - Success
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{midwifeToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "Demo#12345",
    "new_password": "Temp#12345"
  }
}

assert {
  res.status: eq 200
  res.body.message: eq Password changed.
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("reports how many other sessions were signed out", function() {
    expect(res.body.other_sessions_revoked).to.be.a("number");
  });
}
