meta {
  name: Change Password - Unauthenticated
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "Demo#12345",
    "new_password": "Temp#12345"
  }
}

assert {
  res.status: eq 401
  res.body.error.code: eq unauthenticated
}

tests {
  test("status code is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("error code is unauthenticated", function() {
    expect(res.body.error.code).to.equal("unauthenticated");
  });
}
