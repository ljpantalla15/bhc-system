meta {
  name: Change Password - Restore Demo Password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{midwifeToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "Temp#12345",
    "new_password": "Demo#12345"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("status code is 200 (demo password restored)", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Puts midwife1 back on the demo password (Demo#12345) so the collection can run again.
}
