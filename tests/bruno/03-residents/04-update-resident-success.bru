meta {
  name: Update Resident - Success
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/residents/1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bhw1Token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "occupation": "Master Carpenter"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq 1
  res.body.occupation: eq Master Carpenter
}

tests {
  test("status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("resident occupation is updated", function() {
    expect(res.body.occupation).to.equal("Master Carpenter");
  });
}

