meta {
  name: Deactivate Resident - Success
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/api/residents/{{deactivateResidentId}}?reason=Relocated+to+another+barangay
  body: none
  auth: bearer
}

params:query {
  reason: Relocated to another barangay
}

auth:bearer {
  token: {{bhw1Token}}
}

assert {
  res.status: in [200, 404]
}

tests {
  test("status code is 200 OK or 404 if already deactivated", function() {
    expect([200, 404]).to.include(res.getStatus());
    if (res.getStatus() === 200) {
      expect(res.body.is_active).to.equal(false);
    }
  });
}

