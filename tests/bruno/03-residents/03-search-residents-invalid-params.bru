meta {
  name: Search Residents - Invalid Params
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/residents?age_risk_group=INVALID
  body: none
  auth: bearer
}

params:query {
  age_risk_group: INVALID
}

auth:bearer {
  token: {{midwifeToken}}
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("status code is 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("error code is validation_failed", function() {
    expect(res.body.error.code).to.equal("validation_failed");
  });
}

