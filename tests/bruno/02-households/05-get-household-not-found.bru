meta {
  name: Get Household - Not Found
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/households/999999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{midwifeToken}}
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}

tests {
  test("status code is 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });
  test("error code is not_found", function() {
    expect(res.body.error.code).to.equal("not_found");
  });
}

