meta {
  name: List Users - Success
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users?page=1&page_size=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  page_size: 10
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.items: isDefined
  res.body.total: gte 4
}

tests {
  test("status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("never returns password or password_hash", function() {
    for (const u of res.body.items) {
      expect(u.password).to.be.undefined;
      expect(u.password_hash).to.be.undefined;
    }
  });
}

