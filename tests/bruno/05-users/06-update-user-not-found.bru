meta {
  name: Update User - Not Found
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/users/999999
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Ghost User"
  }
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}

tests {
  test("status code is 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });
  test("error code is not_found", function() {
    expect(res.body.error.code).to.equal("not_found");
  });
}

