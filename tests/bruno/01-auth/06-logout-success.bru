meta {
  name: Logout - Success
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
  res.body.message: eq Session ended.
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("message confirms logout", function() {
    expect(res.body.message).to.equal("Session ended.");
  });
}
