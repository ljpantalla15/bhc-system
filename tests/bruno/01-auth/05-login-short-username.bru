meta {
  name: Login - Validation Failed
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "ab",
    "password": "Password123"
  }
}

assert {
  res.status: eq 400
  res.body.error.code: eq validation_failed
}

tests {
  test("status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("error code is validation_failed", function() {
    expect(res.body.error.code).to.equal("validation_failed");
  });
}

