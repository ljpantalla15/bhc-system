# Copy to .env and change every value. Never commit .env.
POSTGRES_DB=bhc
POSTGRES_USER=bhc_owner
POSTGRES_PASSWORD=change_me_owner_password
# Password for the least-privilege role the API uses (set by database/04_set_api_password.sh)
BHC_API_PASSWORD=change_me_api_password
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
SESSION_HOURS=8
